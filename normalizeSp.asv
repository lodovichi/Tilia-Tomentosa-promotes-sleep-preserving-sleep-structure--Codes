
% normalize spectra for Cnt or Tilia, be careful to change the script
% according to which data set you are going to normalize

meanLF = squeeze(mean(totalCntHours(:,:,1,1:5),4));
for nMouse=1:5
    for nCh=1:2
        for nState=1:3
            totalCntN(nMouse,nCh,nState,:) =...
                totalCntHours(nMouse,nCh,nState,:)/meanLF(nMouse,nCh);
        end
    end
end



